<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Shared colors keep the native shell and dialogs consistent. Editor paper uses its own white surface. -->
  <SolidColorBrush x:Key="StudyDesk.WindowBrush" Color="#141C26" />
  <SolidColorBrush x:Key="StudyDesk.PanelBrush" Color="#1B2735" />
  <SolidColorBrush x:Key="StudyDesk.RaisedBrush" Color="#223244" />
  <SolidColorBrush x:Key="StudyDesk.AccentBrush" Color="#93DEC9" />
  <SolidColorBrush x:Key="StudyDesk.TextBrush" Color="#EAF1F7" />
  <SolidColorBrush x:Key="StudyDesk.MutedTextBrush" Color="#B4C3D1" />
  <SolidColorBrush x:Key="StudyDesk.BorderBrush" Color="#344658" />
  <!-- Interactive boundaries meet a stronger contrast target than decorative separators. -->
  <SolidColorBrush x:Key="StudyDesk.InteractiveBorderBrush" Color="#738A9D" />
  <SolidColorBrush x:Key="StudyDesk.InteractiveHoverBrush" Color="#9AB2C5" />
  <SolidColorBrush x:Key="StudyDesk.SelectionBrush" Color="#24443F" />
  <SolidColorBrush x:Key="StudyDesk.HoverBrush" Color="#293D50" />
  <SolidColorBrush x:Key="StudyDesk.AccentTextBrush" Color="#142921" />

  <!-- Focus adorners are outside the control bounds so focus never changes its measured size. -->
  <Style x:Key="StudyDesk.FocusVisual" TargetType="Control">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Control">
          <Border Margin="-3" BorderBrush="{StaticResource StudyDesk.AccentBrush}"
                  BorderThickness="2" CornerRadius="8" SnapsToDevicePixels="True" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Derived windows apply this key explicitly; no implicit Window style is registered. -->
  <Style x:Key="StudyDesk.WindowStyle" TargetType="Window">
    <Setter Property="FontFamily" Value="Segoe UI" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Foreground" Value="{StaticResource StudyDesk.TextBrush}" />
    <Setter Property="Background" Value="{StaticResource StudyDesk.WindowBrush}" />
    <Setter Property="UseLayoutRounding" Value="True" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
  </Style>

  <!-- All buttons share one complete template; their variants change only presentation properties. -->
  <Style x:Key="StudyDesk.Button" TargetType="Button">
    <Setter Property="FontFamily" Value="Segoe UI" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="MinHeight" Value="36" />
    <Setter Property="Padding" Value="14,8" />
    <Setter Property="Foreground" Value="{StaticResource StudyDesk.TextBrush}" />
    <Setter Property="Background" Value="{StaticResource StudyDesk.RaisedBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource StudyDesk.InteractiveBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource StudyDesk.FocusVisual}" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid>
            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" />
            <Border x:Name="InteractionLayer" Background="#14FFFFFF" Opacity="0" CornerRadius="6"
                    IsHitTestVisible="False" />
            <ContentPresenter Margin="{TemplateBinding Padding}" RecognizesAccessKey="True"
                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                              SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="InteractionLayer" Property="Opacity" Value="1" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="InteractionLayer" Property="Background" Value="#20000000" />
              <Setter TargetName="InteractionLayer" Property="Opacity" Value="1" />
            </Trigger>
            <Trigger Property="IsDefaulted" Value="True">
              <Setter Property="BorderBrush" Value="{StaticResource StudyDesk.AccentBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.45" />
              <Setter TargetName="InteractionLayer" Property="Opacity" Value="0" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="StudyDesk.PrimaryButton" TargetType="Button" BasedOn="{StaticResource StudyDesk.Button}">
    <Setter Property="Background" Value="{StaticResource StudyDesk.AccentBrush}" />
    <Setter Property="Foreground" Value="{StaticResource StudyDesk.AccentTextBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource StudyDesk.AccentBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style x:Key="StudyDesk.SecondaryButton" TargetType="Button" BasedOn="{StaticResource StudyDesk.Button}" />
  <Style x:Key="StudyDesk.IconButton" TargetType="Button" BasedOn="{StaticResource StudyDesk.Button}">
    <Setter Property="Width" Value="36" />
    <Setter Property="Height" Value="36" />
    <Setter Property="Padding" Value="8" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>

  <!-- Text input keeps its content host intact for caret, selection, IME and multiline scrolling. -->
  <Style x:Key="StudyDesk.TextBox" TargetType="TextBox">
    <Setter Property="FontFamily" Value="Segoe UI" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="MinHeight" Value="36" />
    <Setter Property="Padding" Value="12,8" />
    <Setter Property="Background" Value="{StaticResource StudyDesk.WindowBrush}" />
    <Setter Property="Foreground" Value="{StaticResource StudyDesk.TextBrush}" />
    <Setter Property="CaretBrush" Value="{StaticResource StudyDesk.TextBrush}" />
    <Setter Property="SelectionBrush" Value="#406E63" />
    <Setter Property="BorderBrush" Value="{StaticResource StudyDesk.InteractiveBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Grid>
            <Border x:Name="Chrome" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="6">
              <ScrollViewer x:Name="PART_ContentHost" Padding="{TemplateBinding Padding}" Focusable="False"
                            HorizontalScrollBarVisibility="{TemplateBinding HorizontalScrollBarVisibility}"
                            VerticalScrollBarVisibility="{TemplateBinding VerticalScrollBarVisibility}" />
            </Border>
            <Border x:Name="FocusRing" BorderBrush="{StaticResource StudyDesk.AccentBrush}"
                    BorderThickness="2" CornerRadius="6" Visibility="Collapsed" IsHitTestVisible="False" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource StudyDesk.InteractiveHoverBrush}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
              <Setter TargetName="FocusRing" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="Validation.HasError" Value="True">
              <Setter TargetName="Chrome" Property="BorderBrush" Value="#F4A89E" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.45" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Token entry uses the same geometry as ordinary fields without replacing PasswordBox behavior. -->
  <Style x:Key="StudyDesk.PasswordBox" TargetType="PasswordBox">
    <Setter Property="FontFamily" Value="Segoe UI" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="MinHeight" Value="36" />
    <Setter Property="Padding" Value="12,8" />
    <Setter Property="Background" Value="{StaticResource StudyDesk.WindowBrush}" />
    <Setter Property="Foreground" Value="{StaticResource StudyDesk.TextBrush}" />
    <Setter Property="CaretBrush" Value="{StaticResource StudyDesk.TextBrush}" />
    <Setter Property="SelectionBrush" Value="#406E63" />
    <Setter Property="BorderBrush" Value="{StaticResource StudyDesk.InteractiveBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource StudyDesk.FocusVisual}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="PasswordBox">
          <Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="6"
                  BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
            <ScrollViewer x:Name="PART_ContentHost" Padding="{TemplateBinding Padding}" Focusable="False" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource StudyDesk.InteractiveHoverBrush}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
              <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource StudyDesk.AccentBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.45" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Scrollbars have no platform-gray arrows; the entire track still supports page commands. -->
  <Style x:Key="StudyDesk.ScrollTrackButton" TargetType="RepeatButton">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RepeatButton">
          <Border Background="Transparent" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="StudyDesk.ScrollThumb" TargetType="Thumb">
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="MinWidth" Value="8" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Thumb">
          <Border x:Name="ThumbChrome" Background="{StaticResource StudyDesk.InteractiveBorderBrush}" CornerRadius="4" Margin="8,2" />
          <ControlTemplate.Triggers>
            <!-- The pointer target stays 24 DIPs wide while the visible grip stays eight DIPs. -->
            <DataTrigger Binding="{Binding Orientation, RelativeSource={RelativeSource AncestorType={x:Type ScrollBar}}}" Value="Horizontal">
              <Setter TargetName="ThumbChrome" Property="Margin" Value="2,8" />
            </DataTrigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="ThumbChrome" Property="Background" Value="{StaticResource StudyDesk.InteractiveHoverBrush}" />
            </Trigger>
            <Trigger Property="IsDragging" Value="True">
              <Setter TargetName="ThumbChrome" Property="Background" Value="{StaticResource StudyDesk.AccentBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="ThumbChrome" Property="Opacity" Value="0.4" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="StudyDesk.ScrollBar" TargetType="ScrollBar">
    <Setter Property="Width" Value="24" />
    <Setter Property="MinWidth" Value="24" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ScrollBar">
          <Grid Background="{TemplateBinding Background}">
            <Track x:Name="PART_Track" Orientation="{TemplateBinding Orientation}"
                   Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}"
                   Value="{TemplateBinding Value}" ViewportSize="{TemplateBinding ViewportSize}"
                   IsDirectionReversed="True" Focusable="False">
              <Track.DecreaseRepeatButton>
                <RepeatButton x:Name="DecreaseButton" Command="ScrollBar.PageUpCommand"
                              Style="{StaticResource StudyDesk.ScrollTrackButton}" />
              </Track.DecreaseRepeatButton>
              <Track.Thumb>
                <Thumb x:Name="ScrollThumb" Style="{StaticResource StudyDesk.ScrollThumb}" />
              </Track.Thumb>
              <Track.IncreaseRepeatButton>
                <RepeatButton x:Name="IncreaseButton" Command="ScrollBar.PageDownCommand"
                              Style="{StaticResource StudyDesk.ScrollTrackButton}" />
              </Track.IncreaseRepeatButton>
            </Track>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
              <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False" />
              <Setter TargetName="DecreaseButton" Property="Command" Value="ScrollBar.PageLeftCommand" />
              <Setter TargetName="IncreaseButton" Property="Command" Value="ScrollBar.PageRightCommand" />
              <Setter TargetName="ScrollThumb" Property="MinWidth" Value="32" />
              <Setter TargetName="ScrollThumb" Property="MinHeight" Value="8" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="Orientation" Value="Horizontal">
        <Setter Property="Width" Value="Auto" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Height" Value="24" />
        <Setter Property="MinHeight" Value="24" />
      </Trigger>
    </Style.Triggers>
  </Style>
  <Style TargetType="ScrollBar" BasedOn="{StaticResource StudyDesk.ScrollBar}" />

  <!-- Combo boxes preserve named popup and editable-text parts, keyboard navigation and text search. -->
  <Style x:Key="StudyDesk.ComboBoxItem" TargetType="ComboBoxItem">
    <Setter Property="FontFamily" Value="Segoe UI" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Padding" Value="10,8" />
    <Setter Property="Margin" Value="4,2" />
    <Setter Property="MinHeight" Value="34" />
    <Setter Property="Foreground" Value="{StaticResource StudyDesk.TextBrush}" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource StudyDesk.FocusVisual}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBoxItem">
          <Grid>
            <Border x:Name="Chrome" Background="Transparent" CornerRadius="4" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="Center" RecognizesAccessKey="True" />
            </Border>
            <Border x:Name="SelectionMarker" Width="3" Margin="0,7,0,7" HorizontalAlignment="Left"
                    Background="{StaticResource StudyDesk.AccentBrush}" CornerRadius="1.5" Visibility="Collapsed"
                    IsHitTestVisible="False" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
              <Setter TargetName="Chrome" Property="Background" Value="{StaticResource StudyDesk.HoverBrush}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="SelectionMarker" Property="Visibility" Value="Visible" />
              <Setter TargetName="Chrome" Property="Background" Value="{StaticResource StudyDesk.SelectionBrush}" />
              <Setter Property="Foreground" Value="{StaticResource StudyDesk.AccentBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.45" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="StudyDesk.ComboBoxEditableTextBox" TargetType="TextBox">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="SelectionBrush" Value="#406E63" />
    <Setter Property="CaretBrush" Value="{StaticResource StudyDesk.TextBrush}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <ScrollViewer x:Name="PART_ContentHost" Focusable="False" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="StudyDesk.ComboBox" TargetType="ComboBox">
    <Setter Property="FontFamily" Value="Segoe UI" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="MinHeight" Value="36" />
    <Setter Property="Padding" Value="12,8" />
    <Setter Property="Background" Value="{StaticResource StudyDesk.WindowBrush}" />
    <Setter Property="Foreground" Value="{StaticResource StudyDesk.TextBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource StudyDesk.InteractiveBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="MaxDropDownHeight" Value="320" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource StudyDesk.FocusVisual}" />
    <Setter Property="ItemContainerStyle" Value="{StaticResource StudyDesk.ComboBoxItem}" />
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
    <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBox">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="36" />
            </Grid.ColumnDefinitions>
            <Border x:Name="Chrome" Grid.ColumnSpan="2" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="6" />
            <ToggleButton x:Name="DropDownToggle" Grid.ColumnSpan="2" Focusable="False" ClickMode="Press"
                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
              <ToggleButton.Template>
                <ControlTemplate TargetType="ToggleButton">
                  <Border Background="Transparent" />
                </ControlTemplate>
              </ToggleButton.Template>
            </ToggleButton>
            <ContentPresenter x:Name="SelectedContent" Grid.Column="0" Margin="12,6,0,6"
                              Content="{TemplateBinding SelectionBoxItem}"
                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                              ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                              VerticalAlignment="Center" IsHitTestVisible="False" />
            <TextBox x:Name="PART_EditableTextBox" Grid.Column="0" Margin="12,6,0,6"
                     Visibility="Hidden" IsReadOnly="{TemplateBinding IsReadOnly}"
                     VerticalContentAlignment="Center" Foreground="{TemplateBinding Foreground}"
                     Style="{StaticResource StudyDesk.ComboBoxEditableTextBox}" />
            <Path Grid.Column="1" Data="M 1,1 L 6,6 L 11,1" StrokeThickness="1.6"
                  Stroke="{StaticResource StudyDesk.MutedTextBrush}" HorizontalAlignment="Center"
                  VerticalAlignment="Center" IsHitTestVisible="False" />
            <Popup x:Name="PART_Popup" Grid.ColumnSpan="2" IsOpen="{TemplateBinding IsDropDownOpen}"
                   Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
              <Border Margin="0,6,0,0" Padding="0,4" CornerRadius="6"
                      MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                      MaxHeight="{TemplateBinding MaxDropDownHeight}"
                      Background="{StaticResource StudyDesk.RaisedBrush}" BorderBrush="{StaticResource StudyDesk.InteractiveBorderBrush}"
                      BorderThickness="1">
                <ScrollViewer CanContentScroll="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                  <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                </ScrollViewer>
              </Border>
            </Popup>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsEditable" Value="True">
              <Setter TargetName="SelectedContent" Property="Visibility" Value="Hidden" />
              <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible" />
              <Setter TargetName="DropDownToggle" Property="Grid.Column" Value="1" />
              <Setter TargetName="DropDownToggle" Property="Grid.ColumnSpan" Value="1" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource StudyDesk.InteractiveHoverBrush}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
              <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource StudyDesk.AccentBrush}" />
            </Trigger>
            <Trigger Property="IsDropDownOpen" Value="True">
              <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource StudyDesk.AccentBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.45" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Checkbox hit areas include the label; the check and indeterminate states remain visually distinct. -->
  <Style x:Key="StudyDesk.CheckBox" TargetType="CheckBox">
    <Setter Property="FontFamily" Value="Segoe UI" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="MinHeight" Value="28" />
    <Setter Property="Padding" Value="0,4" />
    <Setter Property="Foreground" Value="{StaticResource StudyDesk.TextBrush}" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource StudyDesk.FocusVisual}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CheckBox">
          <Grid Background="Transparent" Margin="{TemplateBinding Padding}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="20" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border x:Name="CheckChrome" Width="18" Height="18" HorizontalAlignment="Left" VerticalAlignment="Center"
                    Background="{StaticResource StudyDesk.WindowBrush}" BorderBrush="{StaticResource StudyDesk.InteractiveBorderBrush}"
                    BorderThickness="1" CornerRadius="4">
              <Grid>
                <Path x:Name="CheckMark" Data="M 3,8 L 7,12 L 13,4" Stroke="{StaticResource StudyDesk.AccentTextBrush}"
                      StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed" />
                <Border x:Name="IndeterminateMark" Width="8" Height="2" Background="{StaticResource StudyDesk.AccentTextBrush}"
                        HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
              </Grid>
            </Border>
            <ContentPresenter Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="CheckChrome" Property="BorderBrush" Value="{StaticResource StudyDesk.AccentBrush}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="CheckChrome" Property="Background" Value="{StaticResource StudyDesk.AccentBrush}" />
              <Setter TargetName="CheckChrome" Property="BorderBrush" Value="{StaticResource StudyDesk.AccentBrush}" />
              <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsChecked" Value="{x:Null}">
              <Setter TargetName="CheckChrome" Property="Background" Value="{StaticResource StudyDesk.AccentBrush}" />
              <Setter TargetName="CheckChrome" Property="BorderBrush" Value="{StaticResource StudyDesk.AccentBrush}" />
              <Setter TargetName="IndeterminateMark" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.45" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Tabs stay in a compact inline bar. A thin mint indicator identifies the active section. -->
  <Style x:Key="StudyDesk.TabItem" TargetType="TabItem">
    <Setter Property="FontFamily" Value="Segoe UI" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Foreground" Value="{StaticResource StudyDesk.TextBrush}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="16,12" />
    <Setter Property="Margin" Value="0,0,4,0" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource StudyDesk.FocusVisual}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TabItem">
          <Grid>
            <Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="6,6,0,0"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter x:Name="HeaderContent" ContentSource="Header" RecognizesAccessKey="True"
                                TextElement.Foreground="{StaticResource StudyDesk.MutedTextBrush}"
                                HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <Border x:Name="SelectionIndicator" Height="2" Margin="12,0,12,0" VerticalAlignment="Bottom"
                    Background="{StaticResource StudyDesk.AccentBrush}" CornerRadius="1" Visibility="Collapsed" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Chrome" Property="Background" Value="{StaticResource StudyDesk.RaisedBrush}" />
              <Setter TargetName="HeaderContent" Property="TextElement.Foreground" Value="{StaticResource StudyDesk.TextBrush}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="SelectionIndicator" Property="Visibility" Value="Visible" />
              <Setter TargetName="HeaderContent" Property="TextElement.Foreground" Value="{StaticResource StudyDesk.AccentBrush}" />
              <Setter TargetName="HeaderContent" Property="TextElement.FontWeight" Value="SemiBold" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.4" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="StudyDesk.TabControl" TargetType="TabControl">
    <Setter Property="FontFamily" Value="Segoe UI" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Foreground" Value="{StaticResource StudyDesk.TextBrush}" />
    <Setter Property="Background" Value="{StaticResource StudyDesk.PanelBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource StudyDesk.BorderBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="ItemContainerStyle" Value="{StaticResource StudyDesk.TabItem}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TabControl">
          <Grid KeyboardNavigation.TabNavigation="Local">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border Grid.Row="0" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="0,0,0,1"
                    Background="{TemplateBinding Background}">
              <TabPanel x:Name="HeaderPanel" IsItemsHost="True" KeyboardNavigation.TabIndex="1" />
            </Border>
            <Border Grid.Row="1" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
              <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent"
                                KeyboardNavigation.DirectionalNavigation="Contained" />
            </Border>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Note selections use a calm mint tint, with independent hover and keyboard focus cues. -->
  <Style x:Key="StudyDesk.ListBoxItem" TargetType="ListBoxItem">
    <Setter Property="FontFamily" Value="Segoe UI" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Foreground" Value="{StaticResource StudyDesk.TextBrush}" />
    <Setter Property="Padding" Value="12,10" />
    <Setter Property="Margin" Value="0,0,0,4" />
    <Setter Property="MinHeight" Value="38" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource StudyDesk.FocusVisual}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <Grid>
            <Border x:Name="Chrome" Background="Transparent" BorderBrush="Transparent" BorderThickness="1"
                    CornerRadius="6" Padding="{TemplateBinding Padding}" ClipToBounds="True">
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
            </Border>
            <Border x:Name="SelectionMarker" Width="3" Margin="0,8,0,8" HorizontalAlignment="Left"
                    Background="{StaticResource StudyDesk.AccentBrush}" CornerRadius="1.5" Visibility="Collapsed"
                    IsHitTestVisible="False" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Chrome" Property="Background" Value="{StaticResource StudyDesk.HoverBrush}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="SelectionMarker" Property="Visibility" Value="Visible" />
              <Setter TargetName="Chrome" Property="Background" Value="{StaticResource StudyDesk.SelectionBrush}" />
              <Setter TargetName="Chrome" Property="BorderBrush" Value="#3F695F" />
              <Setter Property="Foreground" Value="{StaticResource StudyDesk.AccentBrush}" />
              <Setter Property="FontWeight" Value="SemiBold" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.45" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="StudyDesk.ListBox" TargetType="ListBox">
    <Setter Property="FontFamily" Value="Segoe UI" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Foreground" Value="{StaticResource StudyDesk.TextBrush}" />
    <Setter Property="Background" Value="{StaticResource StudyDesk.PanelBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource StudyDesk.BorderBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="4" />
    <Setter Property="ItemContainerStyle" Value="{StaticResource StudyDesk.ListBoxItem}" />
    <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
    <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
    <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBox">
          <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
            <ScrollViewer Focusable="False" Padding="{TemplateBinding Padding}"
                          CanContentScroll="{TemplateBinding ScrollViewer.CanContentScroll}">
              <ItemsPresenter />
            </ScrollViewer>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.45" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="StudyDesk.ToolTip" TargetType="ToolTip">
    <Setter Property="FontFamily" Value="Segoe UI" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{StaticResource StudyDesk.TextBrush}" />
    <Setter Property="Background" Value="{StaticResource StudyDesk.RaisedBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource StudyDesk.BorderBrush}" />
    <Setter Property="Padding" Value="10,8" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToolTip">
          <Border CornerRadius="6" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"
                  BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
            <ContentPresenter />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="StudyDesk.Separator" TargetType="Separator">
    <Setter Property="Margin" Value="0,12" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Separator">
          <Border Height="1" Background="{StaticResource StudyDesk.BorderBrush}" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
