# Copy configuration to a private .env file; never commit real settings or secrets.
# The Windows app creates its own private .env under LocalAppData on first launch.
STUDYDESK_DESKTOP_DATA_DIR=<ABSOLUTE_PRIVATE_DESKTOP_DATA_DIRECTORY>
STUDYDESK_DESKTOP_ALLOW_INSECURE_LOOPBACK=false
STUDYDESK_DESKTOP_TOKEN_FILE=<ABSOLUTE_PRIVATE_PROTECTED_TOKEN_FILE>
STUDYDESK_DESKTOP_CONNECTION_FILE=<ABSOLUTE_PRIVATE_CONNECTION_METADATA_FILE>

# The server reads the explicitly selected private environment file.
STUDYDESK_SERVER_ENV_FILE=<ABSOLUTE_PRIVATE_ENV_FILE>
STUDYDESK_SERVER_DATA_DIR=<ABSOLUTE_PRIVATE_SERVER_DATA_DIRECTORY>
STUDYDESK_SERVER_ORIGIN=https://sync.example.invalid
STUDYDESK_SERVER_ALLOW_INSECURE_LOOPBACK=false
ASPNETCORE_URLS=https://127.0.0.1:7443

# Optional explicit private desktop environment file for isolated installations.
STUDYDESK_DESKTOP_ENV_FILE=

# Optional private HTTPS certificate configuration for the server.
ASPNETCORE_Kestrel__Certificates__Default__Path=<ABSOLUTE_PRIVATE_PFX_FILE>
ASPNETCORE_Kestrel__Certificates__Default__Password=<PRIVATE_PFX_PASSWORD>

# Local interface language: auto, it or en. User-written notes are not translated.
STUDYDESK_DESKTOP_LANGUAGE=auto
